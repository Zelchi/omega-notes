---
import BaseLayout from "@/layouts/base-layout.astro";
import VideoPlayer from "@/components/video-player.astro";
import GettingStartedGuide from "@/components/getting-started-guide.astro";
import AppFeatures from "@/components/app-features.astro";

const repository = "https://github.com/Zelchi/omega-notes";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<BaseLayout>
    <main class="home">
        <img
            class="logo"
            src={`${base}icon.png`}
            alt=""
            width="80"
            height="80"
        />
        <p class="eyebrow">Ômega Notes</p>
        <h1>Um espaço para suas ideias.</h1>
        <p class="description">
            Escreva suas notas, conecte assuntos e organize seus estudos em um
            canvas. Seus arquivos ficam no seu computador.
        </p>
        <nav class="actions" aria-label="Conheça o Ômega Notes">
            <div class="downloads">
                <a
                    class="button"
                    href={`${repository}/releases/latest/download/omega-notes-windows-x64.exe`}
                    ><img class="platform-icon" src={`${base}platform-icons/windows.svg`} alt="" />Windows</a
                >
                <a
                    class="button"
                    href={`${repository}/releases/latest/download/omega-notes-ubuntu-x64.deb`}
                    ><img class="platform-icon" src={`${base}platform-icons/ubuntu.svg`} alt="" />Ubuntu</a
                >
                <a
                    class="button"
                    href={`${repository}/releases/latest/download/omega-notes-fedora-x64.rpm`}
                    ><img class="platform-icon" src={`${base}platform-icons/fedora.ico`} alt="" />Fedora</a
                >
            </div>
            <a class="repository" href={repository}
                >Ver no GitHub <span aria-hidden="true">↗</span></a
            >
        </nav>
        <figure class="demo">
            <VideoPlayer src={`${base}omega-1.mp4`} />
            <figcaption>Veja o Ômega Notes em ação.</figcaption>
        </figure>
        <AppFeatures />
        <GettingStartedGuide />
    </main>
</BaseLayout>
