{
    "name": "omega-notes-desktop",
    "private": true,
    "version": "0.5.0",
    "type": "module",
    "scripts": {
        "dev": "vite frontend --config frontend/vite.config.ts --host 127.0.0.1 --port 1420",
        "typecheck": "tsc --project frontend/tsconfig.json --noEmit",
        "test": "node --conditions=browser --import ./frontend/test/register.mjs --experimental-strip-types --test --experimental-test-isolation=none frontend/test/*.test.mjs",
        "build": "tsc --project frontend/tsconfig.json --noEmit && vite build frontend --config frontend/vite.config.ts"
    },
    "dependencies": {
		"@tauri-apps/api": "^2.0.0",
		"@tauri-apps/plugin-dialog": "^2.0.0",
		"@tauri-apps/plugin-opener": "^2.0.0",
		"@tauri-apps/plugin-updater": "^2.0.0",
        "@vanilla-extract/css": "^1.21.3",
        "@xterm/addon-fit": "^0.11.0",
        "@xterm/xterm": "^6.0.0",
        "prismjs": "^1.30.0",
        "solid-js": "^1.9.15"
    },
    "devDependencies": {
        "@types/node": "^24.13.4",
        "@vanilla-extract/vite-plugin": "^5.2.6",
        "electron": "45.0.0",
        "electron-builder": "26.15.3",
        "typescript": "~5.9.3",
        "vite": "^8.2.2",
        "vite-plugin-solid": "^2.11.14"
    },
    "main": "bridge/electron/main.mjs",
    "description": "Um espaço local para guardar e organizar seus estudos",
    "author": "Ômega Notes <zelchi@users.noreply.github.com>",
    "homepage": "https://github.com/Zelchi/omega-notes"
}
