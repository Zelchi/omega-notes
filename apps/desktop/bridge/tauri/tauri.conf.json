{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Ômega Notes",
	"version": "0.5.1",
	"identifier": "com.omegastudy.app",
	"build": {
		"beforeDevCommand": {
			"script": "node ../../scripts/desktop-tauri.mjs dev",
			"cwd": "../..",
			"wait": false
		},
		"devUrl": "http://127.0.0.1:1420",
		"beforeBuildCommand": {
			"script": "node ../../scripts/desktop-tauri.mjs build",
			"cwd": "../.."
		},
		"frontendDist": "../../frontend/dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "Ômega Notes",
				"width": 1000,
				"height": 700,
				"minWidth": 900,
				"minHeight": 700,
				"decorations": false,
				"backgroundColor": "#141416"
			}
		],
		"security": {
			"csp": "default-src 'self'; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; media-src 'self' blob: data: http://127.0.0.1:*; font-src 'self' data:; connect-src 'self' https://*.api.radio-browser.info https://api.somafm.com; object-src 'none'; base-uri 'none'; frame-src 'none'"
		}
	},
	"bundle": {
		"active": true,
		"targets": ["nsis"],
		"icon": ["../electron/icons/icon.png", "../electron/icons/icon.ico"]
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBCOTM5RTMzM0M4RjI1M0IKUldRN0pZODhNNTZUQzhjU0liVGxJQnMzeE85VGFmMzRkK0Rqd0FCSVJhRVFWa0hnd2M1UHYzcXIK",
			"endpoints": [
				"https://github.com/Zelchi/omega-notes/releases/latest/download/native-latest.json"
			],
			"windows": {
				"installMode": "passive"
			}
		}
	}
}
