{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ômega Notes",
  "version": "0.3.6",
  "identifier": "com.omegastudy.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ômega",
        "width": 1000,
        "height": 700,
        "minWidth": 900,
        "minHeight": 700,
        "decorations": false,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#111112"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBFMzVEMjZCQTEwQjFFRUEKUldUcUhndWhhOUkxRG1IbTVZRWNTM2RkTTRCUW1FSGRMM0JnVERLSUovUm5yTkFySjZMSXFJT3MK",
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
