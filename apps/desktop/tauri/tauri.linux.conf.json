{
  "$schema": "https://schema.tauri.app/config/3",
  "productName": "Omega Notes",
  "bundle": {
    "targets": [
      "deb",
      "rpm"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libgtk-4-1",
          "zenity"
        ],
        "desktopTemplate": "linux.desktop"
      },
      "rpm": {
        "depends": [
          "gtk4",
          "zenity"
        ],
        "desktopTemplate": "linux.desktop"
      }
    }
  }
}
