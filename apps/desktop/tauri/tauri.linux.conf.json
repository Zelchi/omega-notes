{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Omega Notes",
  "bundle": {
    "targets": [
      "deb",
      "rpm"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libgtk-3-0",
          "libwebkit2gtk-4.1-0",
          "pkexec",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good"
        ],
        "desktopTemplate": "linux.desktop"
      },
      "rpm": {
        "depends": [
          "gtk3",
          "webkit2gtk4.1",
          "polkit",
          "gstreamer1-plugins-base",
          "gstreamer1-plugins-good"
        ],
        "desktopTemplate": "linux.desktop"
      }
    }
  }
}
